; TIM-011 ADDRESS DECODER FOR V2.2 BOARD
; BY MARKO SOLAJIC (8BITCHIP) 2026

CHIP TIM_ADDR_V22 16V8

GND=10 ; Ground
VCC=20 ; *5V

; -----------------------------------------------------------------------------
; INPUTS
; -----------------------------------------------------------------------------

A15  =2
A7   =3
A6   =4
A5   =5
A4   =6
IOE  =7
A3   =8
A2   =9

; -----------------------------------------------------------------------------
; Output
; -----------------------------------------------------------------------------

/FDCSEL=12
/FDCDMA=13
/EXPSEL=14
/PRINT =15
/IDECS =16
/LATCH  =19

; -----------------------------------------------------------------------------
EQUATIONS
; -----------------------------------------------------------------------------

FDCSEL = /IOE * /A15 * A7 * /A6 * /A5                ; 80-9F

FDCDMA = /IOE * /A15 * A7 * /A6 *  A5                ; A0-BF

PRINT  = /IOE * /A15 * A7 *  A6 * /A5 * /A4 * /A3    ; C0-C7

; D0-DF is decoded in the CPLD

EXPSEL = /IOE * /A15 * A7 *  A6 *  A5 * /A4 * /A3 +  ; E0-E7 +
         /IOE * /A15 * A7 *  A6 *  A5 *  A4 * /A3 +  ; F0-F7 +
         /IOE * /A15 * A7 *  A6 *  A5 *  A4 *  A3    ; F8-FF

IDECS  = /IOE * /A15 * A7 *  A6 *  A5 * /A4 *  A3    ; E8-EF


LATCH  = /IOE * /A15 * A7 * A6 * /A5 * /A4 * A3 * /A2    ; 1. Set at 0xC8, reset on 0xCC
       # LATCH * IOE                                     ; 2. Hold
       # LATCH * A15                                     ; 3. Hold
       # LATCH * /A7                                     ; 4. Hold
       # LATCH * /A6                                     ; 5. Hold
       # LATCH * A5                                      ; 6. Hold
       # LATCH * A4                                      ; 7. Hold
       # LATCH * /A3                                     ; 8. Hold
